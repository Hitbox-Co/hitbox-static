{
  "expo": {
    "name": "hitbox-static",
    "slug": "hitbox-static",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hitboxstatic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:hitboxcollectibles.com",
        "applinks:www.hitboxcollectibles.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#010101",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "hitboxcollectibles.com", "pathPrefix": "/verify" },
            { "scheme": "https", "host": "www.hitboxcollectibles.com", "pathPrefix": "/verify" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.anonymous.hitboxstatic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010101",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "HitBox uses NFC to scan and claim your collectibles."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HitBox uses your location once to show prices in your local currency."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
